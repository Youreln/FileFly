{
  "name": "filefly",
  "version": "1.1.0",
  "description": "飞传 FileFly - 局域网高速文件传输工具",
  "main": "electron.js",
  "author": "Youreln <youreln@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://youreln.github.io/FileFly",
  "repository": {
    "type": "git",
    "url": "https://github.com/Youreln/FileFly"
  },
  "keywords": [
    "file-transfer",
    "lan",
    "local-network",
    "upload",
    "download",
    "filefly",
    "electron"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "build:win": "npm run build:prepare && electron-builder --win",
    "build:mac": "npm run build:prepare && electron-builder --mac",
    "build:linux": "npm run build:prepare && electron-builder --linux",
    "build:all": "npm run build:prepare && electron-builder -wml",
    "build:prepare": "node scripts/build-prepare.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.youreln.filefly",
    "productName": "飞传 FileFly",
    "copyright": "Copyright © 2026 Youreln",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!docs/**",
      "!.github/**",
      "!uploads/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "FileFly-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "飞传 FileFly"
    },
    "portable": {
      "artifactName": "FileFly-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "FileFly-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "FileFly-${version}-linux-${arch}.${ext}"
    }
  }
}
